# ============================================================
# Spotlight - variaveis de ambiente (exemplo unico)
# Copie este arquivo para .env na raiz do repositorio e preencha
# os valores reais. O arquivo .env nao deve ser versionado.
# ============================================================

# ------------------------------------------------------------
# Ambiente
# ------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# As portas locais dos projetos .NET sao definidas nos launchSettings.json:
# Gateway: http://localhost:5000
# Catalogo: http://localhost:5001
# Usuario: http://localhost:5002
# Recomendacao: http://localhost:5003
# Geolocalizacao: http://localhost:5004
#
# No Docker Compose, os servicos rodam internamente em http://+:8080
# e sao publicados nas mesmas portas locais acima.

# ------------------------------------------------------------
# Backend .NET / Docker Compose
# Catalogo, Usuario e Recomendacao leem DATABASE_CONNECTION_STRING.
# O docker-compose.yml tambem injeta DATABASE_CONNECTION_STRING e
# SUPABASE_JWT_SECRET nos containers desses servicos.
# ------------------------------------------------------------
DATABASE_CONNECTION_STRING=
SUPABASE_JWT_SECRET=

# Exemplo para Supabase (use a senha do projeto):
# DATABASE_CONNECTION_STRING=Host=db.project-ref.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=sua-senha;SSL Mode=Require;Trust Server Certificate=true

# ------------------------------------------------------------
# Supabase / autenticacao
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: use quando validar JWT por JWKS no servico de usuario.
# SUPABASE_AUTH_JWKS_URL=https://project-ref.supabase.co/auth/v1/.well-known/jwks.json

# ------------------------------------------------------------
# Frontend Expo
# Variaveis EXPO_PUBLIC_* podem ir para o bundle mobile.
# ------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://nyaxqgujyyvkjnqzbklf.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
EXPO_PUBLIC_AUTH_REDIRECT_URL=spotlightmobile://email-confirmado

# ------------------------------------------------------------
# Geolocalizacao / Nominatim
# ------------------------------------------------------------
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=spotlight-inteli-g04/1.0

# ------------------------------------------------------------
# PostgreSQL local / ferramentas de banco
# Estas variaveis nao sao consumidas pelo docker-compose atual, mas ajudam
# clientes locais e scripts documentados em src/database.
# ------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/postgres

# ------------------------------------------------------------
# Telemetria
# ------------------------------------------------------------
MONGODB_CONNECTION_STRING=
MONGODB_DATABASE=spotlight_telemetry
MONGODB_TELEMETRY_COLLECTION=interacoes
# RABBITMQ_URL=
