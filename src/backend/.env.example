# ============================================================
# Spotlight API — variáveis de ambiente (exemplo)
# Copie este arquivo para .env e preencha com os valores reais.
#   cp .env.example .env
# O .env NÃO deve ser versionado (já está no .gitignore).
# ============================================================

# Ambiente: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# URL/porta em que a API sobe
ASPNETCORE_URLS=http://localhost:5000

# ------------------------------------------------------------
# Conexão com o PostgreSQL (Supabase)
# Formato de connection string do Npgsql.
# ------------------------------------------------------------
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=spotlight;Username=postgres;Password=postgres

# Exemplo para Supabase (use a senha do projeto):
# DATABASE_CONNECTION_STRING=Host=db.<id-do-projeto>.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<senha>;SSL Mode=Require;Trust Server Certificate=true
