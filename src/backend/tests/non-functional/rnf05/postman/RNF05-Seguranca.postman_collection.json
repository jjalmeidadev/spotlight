  "item": [
    {
      "name": "Cenários negativos obrigatórios",
      "item": [
        {
          "name": "RNF05-N01 — Recomendação sem token retorna 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{recommendation_base_url}}/me?limite=10",
              "host": [
                "{{recommendation_base_url}}"
              ],
              "path": [
                "me"
              ],
              "query": [
                {
                  "key": "limite",
                  "value": "10"
                }
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401 para token ausente', () => pm.response.to.have.status(401));",
                  "pm.test('Resposta não expõe segredo', () => { const body = pm.response.text().toLowerCase(); pm.expect(body).to.not.include('supabase_jwt_secret'); pm.expect(body).to.not.include('password='); });"
                ]
              }
            }
          ]
        },
