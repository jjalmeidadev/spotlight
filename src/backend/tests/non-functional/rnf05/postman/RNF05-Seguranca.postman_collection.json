    {
      "name": "Cenários com credenciais fornecidas em runtime",
      "item": [
        {
          "name": "RNF05-P01 — Token válido é aceito na recomendação",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{recommendation_base_url}}/me?limite=10",
              "host": [
                "{{recommendation_base_url}}"
              ],
              "path": [
                "me"
              ],
              "query": [
                {
                  "key": "limite",
                  "value": "10"
                }
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const value = pm.variables.get('access_token') || pm.environment.get('access_token');",
                  "if (!value || value.trim().length === 0) { console.warn('ACCESS_TOKEN não informado; cenário positivo ignorado.'); pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token válido não é rejeitado por autenticação', () => { pm.expect(pm.response.code).to.not.eql(401); pm.expect(pm.response.code).to.not.eql(403); });",
                  "pm.test('Resposta não expõe segredos', () => { const body = pm.response.text().toLowerCase(); pm.expect(body).to.not.include('supabase_jwt_secret'); pm.expect(body).to.not.include('service_role_key'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "RNF05-N06 — Usuário comum não acessa rota administrativa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{common_user_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{catalog_base_url}}/espetaculos",
              "host": [
                "{{catalog_base_url}}"
              ],
              "path": [
                "espetaculos"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const value = pm.variables.get('common_user_token') || pm.environment.get('common_user_token');",
                  "if (!value || value.trim().length === 0) { console.warn('COMMON_USER_TOKEN não informado; cenário 403 ignorado.'); pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Usuário cadastrado sem papel de administrador recebe 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
