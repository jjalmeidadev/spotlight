# ============================================================
# RNF06 — Carga e escalabilidade
# ============================================================

# Endereços dos serviços executados localmente
CATALOG_BASE_URL=http://localhost:5001
RECOMMENDATION_BASE_URL=http://localhost:5003

# Rotas utilizadas no teste
CATALOG_PATH=/espetaculos?page=1&pageSize=20
SEARCH_PATH=/espetaculos?q=Hamlet&page=1&pageSize=20
RECOMMENDATION_PATH=/me?limite=10

# Health checks
CATALOG_HEALTH_PATH=/health/ready
RECOMMENDATION_HEALTH_PATH=/health/ready

# Token JWT de um usuário autenticado
# Não coloque tokens reais neste arquivo versionado
ACCESS_TOKEN=

# Quando true, o teste exige ACCESS_TOKEN
REQUIRE_RECOMMENDATION=true

# Permite iniciar mesmo com health check indisponível
# Deve permanecer false em execuções oficiais
ALLOW_UNHEALTHY_START=false

# Cenário principal
K6_VUS=200
K6_DURATION=10m

# Cenário negativo de sobrecarga
K6_NEGATIVE_VUS=300
K6_RECOVERY_VUS=50

K6_NEGATIVE_RAMP_UP=1m
K6_NEGATIVE_BASELINE=2m
K6_NEGATIVE_OVERLOAD_RAMP=1m
K6_NEGATIVE_OVERLOAD_DURATION=5m
K6_NEGATIVE_RECOVERY_RAMP=1m
K6_NEGATIVE_RECOVERY_DURATION=2m

# Critérios de aceitação
K6_MAX_AVG_DURATION_MS=3000
K6_MAX_ERROR_RATE=0.01

# Intervalo entre as iterações de cada usuário virtual
K6_THINK_TIME_SECONDS=1