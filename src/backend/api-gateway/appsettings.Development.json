{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "catalogo": {
        "ClusterId": "catalogo",
        "Match": { "Path": "/catalogo/{**catch-all}" }
      },
      "usuario": {
        "ClusterId": "usuario",
        "Match": { "Path": "/usuario/{**catch-all}" }
      },
      "recomendacao": {
        "ClusterId": "recomendacao",
        "Match": { "Path": "/recomendacao/{**catch-all}" }
      }
    },
    "Clusters": {
      "catalogo": {
        "Destinations": { "d1": { "Address": "http://localhost:5001/" } }
      },
      "usuario": {
        "Destinations": { "d1": { "Address": "http://localhost:5002/" } }
      },
      "recomendacao": {
        "Destinations": { "d1": { "Address": "http://localhost:5003/" } }
      }
    }
  }
}
