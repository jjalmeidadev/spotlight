{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "catalogo": {
        "ClusterId": "catalogo",
        "Match": { "Path": "/catalogo/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/catalogo" } ]
      },
      "usuario": {
        "ClusterId": "usuario",
        "Match": { "Path": "/usuario/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/usuario" } ]
      },
      "recomendacao": {
        "ClusterId": "recomendacao",
        "Match": { "Path": "/recomendacao/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/recomendacao" } ]
      },
      "geolocalizacao": {
        "ClusterId": "geolocalizacao",
        "Match": { "Path": "/geolocalizacao/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/geolocalizacao" } ]
      }
    },
    "Clusters": {
      "catalogo": {
        "Destinations": { "d1": { "Address": "http://catalogo:8080/" } }
      },
      "usuario": {
        "Destinations": { "d1": { "Address": "http://usuario:8080/" } }
      },
      "recomendacao": {
        "Destinations": { "d1": { "Address": "http://recomendacao:8080/" } }
      },
      "geolocalizacao": {
        "Destinations": { "d1": { "Address": "http://geolocalizacao:8080/" } }
      }
    }
  }
}
