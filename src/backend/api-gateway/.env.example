# ============================================================
# Spotlight — API Gateway — variáveis de ambiente (exemplo)
# Copie este arquivo para .env e preencha com os valores reais.
#   cp .env.example .env
# O .env NÃO deve ser versionado.
# ============================================================

# Ambiente: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# URL/porta em que o gateway sobe (ponto único de entrada)
ASPNETCORE_URLS=http://localhost:5000

# Os destinos dos serviços (catálogo/usuário/recomendação) ficam na seção
# "ReverseProxy" do appsettings. A configuração de JWT (Supabase Auth) entra posteriormente.
