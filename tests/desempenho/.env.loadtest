# Variaveis exclusivas do stack de teste de carga.
# Nao reaproveite no .env da raiz — apontam para Postgres/Mongo locais.

POSTGRES_PASSWORD=spotlight_loadtest
POSTGRES_DB=postgres
POSTGRES_USER=postgres

# Connection string usada pelos servicos .NET dentro do compose loadtest.
DATABASE_CONNECTION_STRING_LOCAL=Host=db;Port=5432;Database=postgres;Username=postgres;Password=spotlight_loadtest;Maximum Pool Size=200;Timeout=30
MONGODB_CONNECTION_STRING_LOCAL=mongodb://mongo:27017
MONGODB_DATABASE=spotlight_telemetry
MONGODB_TELEMETRY_COLLECTION=interacoes

# Segredo HS256 com 64 bytes — usado para assinar JWTs no k6 e validar no backend.
# E exclusivamente local; nunca foi e nunca devera ser usado em ambiente real.
SUPABASE_JWT_SECRET_LOCAL=loadtest-secret-64-bytes-padding-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
